{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://hrntechsolutions.com/mereawaz_backend/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://hrntechsolutions.com/mereawaz_backend/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
